FROM nginx:1.20-alpine

# 安装编译依赖
RUN apk add --no-cache \
    build-base \
    pcre-dev \
    zlib-dev \
    openssl-dev \
    wget \
    git

WORKDIR /tmp

# 下载 nginx 1.20.2 源码和 naxsi 1.3 版本
RUN wget https://nginx.org/download/nginx-1.20.2.tar.gz && \
    wget https://github.com/nbs-system/naxsi/archive/1.3.tar.gz -O naxsi-1.3.tar.gz && \
    tar zxvf nginx-1.20.2.tar.gz && \
    tar zxvf naxsi-1.3.tar.gz && \
    cd nginx-1.20.2 && \
    ./configure --with-compat --add-dynamic-module=../naxsi-1.3/naxsi_src && \
    make modules && \
    mkdir -p /usr/lib/nginx/modules /etc/nginx/modules-enabled && \
    cp objs/ngx_http_naxsi_module.so /usr/lib/nginx/modules/ && \
    echo "load_module /usr/lib/nginx/modules/ngx_http_naxsi_module.so;" > /etc/nginx/modules-enabled/50-naxsi.conf

# 清理构建依赖和源码
RUN apk del build-base pcre-dev zlib-dev openssl-dev wget git && \
    rm -rf /tmp/naxsi-1.3 /tmp/nginx-1.20.2 /tmp/nginx-1.20.2.tar.gz /tmp/naxsi-1.3.tar.gz

# 复制配置文件
COPY nginx.conf /etc/nginx/nginx.conf
COPY naxsi_core.rules /etc/nginx/naxsi_core.rules
COPY naxsi.rules /etc/nginx/naxsi.rules

RUN mkdir -p /var/log/nginx

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"] 